# Vercel Blob, used for short share links (/s/<id>). Set automatically when a
# Blob store is connected to the project in Vercel (Storage tab). Without it,
# share links fall back to long self-contained URLs.
BLOB_READ_WRITE_TOKEN=
# Must match the Blob store's access type. Defaults to private.
# SHARE_BLOB_ACCESS=public

# Optional: public URL used for link-preview images. Defaults to
# https://willsplit.vercel.app in production.
# SITE_URL=https://willsplit.vercel.app
